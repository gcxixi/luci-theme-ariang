{#
 AriaNg High-Density Design Theme for LuCI
 Copyright (C) 2026 gcxixi
-#}
{%
	const boardinfo = ubus.call('system', 'board') ?? {};
	http.prepare_content('text/html; charset=UTF-8');
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{{ striptags(`${boardinfo.hostname ?? 'R5C Gateway'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }} - LuCI</title>
    <link rel="stylesheet" href="{{ media }}/css/cascade.css">
    <script src="{{ media }}/js/ariang-enhancer.js" defer></script>
</head>
<body>
<div id="ariang-app-container">
    <aside id="ariang-sidebar">
        <a class="ariang-brand" href="{{ url('') }}">
            <span>{{ boardinfo.hostname ?? 'R5C Gateway' }}</span>
            <span class="ariang-brand-tag">AriaNg UI</span>
        </a>
        <ul class="ariang-nav" id="mainmenu">
            <!-- LuCI JS dynamically populates items here -->
        </ul>
    </aside>

    <div id="ariang-main">
        <header id="ariang-header">
            <div class="ariang-page-title">
                <span>{{ boardinfo.hostname ?? 'R5C Gateway' }}</span>
                <span style="color:var(--text-muted); font-weight:normal;">/</span>
                <span style="color:var(--primary);">{{ dispatched?.title ? _(dispatched.title) : 'Control Panel' }}</span>
            </div>
            <div class="ariang-top-actions">
                <span class="ariang-badge" style="font-family:var(--ariang-font-mono); font-size:12px; color:var(--text-muted);">
                    ⌨ Cmd+K to search
                </span>
            </div>
        </header>

        <main id="maincontent">
